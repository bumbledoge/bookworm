# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite by default for zero-friction local development)
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead:
#  1. In prisma/schema.prisma change `provider = "sqlite"` to `provider = "postgresql"`
#  2. Set DATABASE_URL below
#  3. Run `npm run prisma:push` (or `prisma migrate dev`) and `npm run db:seed`
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookworm?schema=public"
